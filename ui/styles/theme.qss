/* =========================================================================
   DiskScope · warm paper theme
   ========================================================================= */

* {
    outline: none;
}

QWidget {
    color: #292723;
    background: transparent;
    selection-background-color: #DCD3C5;
    selection-color: #292723;
}

QMainWindow, QDialog {
    background: transparent;
}

/* -------------------------------------------------------------------------
   Window shell
   ------------------------------------------------------------------------- */

QFrame#windowSurface {
    background-color: #F3F0EA;
    border: 1px solid #DCD6CC;
    border-radius: 22px;
}

QFrame#windowSurface[windowMaximized="true"] {
    border-radius: 0px;
    border: none;
}

QWidget#titleBar {
    background-color: transparent;
    border-bottom: 1px solid rgba(221, 216, 207, 0.72);
}

QLabel#brandName {
    color: #292723;
    font-size: 20px;
    font-weight: 600;
    padding-left: 1px;
}

QLabel#brandSub {
    color: #9A948A;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 1px;
}

QFrame#brandDivider {
    background: #DAD4CA;
    border: none;
}

QPushButton#navButton {
    background: transparent;
    border: none;
    border-radius: 10px;
    color: #777269;
    font-size: 15px;
    font-weight: 500;
    padding: 8px 15px;
    text-align: center;
}

QPushButton#navButton:hover {
    background: rgba(232, 227, 218, 0.72);
    color: #38352F;
}

QPushButton#navButton:checked {
    background: #E7E1D6;
    color: #292723;
    font-weight: 600;
}

QPushButton#refreshButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    color: #777269;
    font-size: 13px;
    font-weight: 500;
    padding: 7px 11px;
}

QPushButton#refreshButton:hover {
    background: #ECE6DC;
    border-color: #E0D9CE;
    color: #292723;
}

QPushButton#refreshButton:pressed {
    background: #E4DED3;
}

QPushButton#refreshButton:disabled {
    color: #B6B0A6;
}

QPushButton#settingsNavButton {
    background: transparent;
    border: none;
    border-radius: 9px;
    color: #7A756B;
    font-size: 13px;
    font-weight: 500;
    padding: 8px 11px;
    text-align: left;
}

QPushButton#settingsNavButton:hover {
    background: #EEE9E0;
    color: #35322D;
}

QPushButton#settingsNavButton:checked {
    background: #E7E1D6;
    color: #292723;
    font-weight: 600;
}

/* -------------------------------------------------------------------------
   Typography
   ------------------------------------------------------------------------- */

QLabel#pageEyebrow {
    color: #969087;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
}

QLabel#pageTitle {
    color: #292723;
    font-size: 25px;
    font-weight: 600;
}

QLabel#pageSubtitle {
    color: #858078;
    font-size: 13px;
    font-weight: 400;
}

QLabel#sectionTitle {
    color: #292723;
    font-size: 16px;
    font-weight: 600;
}

QLabel#sectionCaption {
    color: #918B82;
    font-size: 12px;
    font-weight: 400;
}

QLabel#metricCaption {
    color: #88847C;
    font-size: 13px;
    font-weight: 500;
}

QLabel#heroNumber {
    color: #292723;
    font-size: 56px;
    font-weight: 500;
}

QLabel#heroUnit {
    color: #6F6A61;
    font-size: 24px;
    font-weight: 500;
}

QLabel#metricValue {
    color: #292723;
    font-size: 23px;
    font-weight: 600;
}

QLabel#metricUnit {
    color: #8B867D;
    font-size: 12px;
    font-weight: 500;
}

QLabel#mutedText {
    color: #8B867D;
    font-size: 12px;
}

QLabel#subtleText {
    color: #A09A90;
    font-size: 11px;
}

QLabel#strongText {
    color: #292723;
    font-size: 13px;
    font-weight: 600;
}

QLabel#rowTitle {
    color: #302D28;
    font-size: 13px;
    font-weight: 600;
}

QLabel#rowMeta {
    color: #989288;
    font-size: 11px;
}

QLabel#unitPill {
    background: #ECE6DB;
    color: #645F56;
    border: 1px solid #E2DBD0;
    border-radius: 8px;
    padding: 2px 7px;
    font-size: 10px;
    font-weight: 600;
}

QLabel#statusSuccess {
    background: #E7EADF;
    color: #65725A;
    border-radius: 8px;
    padding: 3px 8px;
    font-size: 10px;
    font-weight: 600;
}

QLabel#statusMuted {
    background: #EEE9E0;
    color: #8B857B;
    border-radius: 8px;
    padding: 3px 8px;
    font-size: 10px;
    font-weight: 600;
}

QLabel#statusWarning {
    background: #F1E5D6;
    color: #946D43;
    border-radius: 8px;
    padding: 3px 8px;
    font-size: 10px;
    font-weight: 600;
}

QLabel#statusDanger {
    background: #F1E1DD;
    color: #95564E;
    border-radius: 8px;
    padding: 3px 8px;
    font-size: 10px;
    font-weight: 600;
}

/* -------------------------------------------------------------------------
   Surfaces
   ------------------------------------------------------------------------- */

QFrame#surfaceCard {
    background-color: #F8F6F1;
    border: 1px solid #E5DFD5;
    border-radius: 18px;
}

QFrame#surfaceCardRaised {
    background-color: #FCFAF6;
    border: 1px solid #E9E3D9;
    border-radius: 18px;
}

QFrame#mutedCard {
    background-color: #EDE8DF;
    border: none;
    border-radius: 16px;
}

QFrame#darkCard {
    background-color: #2C2A26;
    border: 1px solid #2C2A26;
    border-radius: 18px;
}

QFrame#hairline {
    background: #E5DFD5;
    border: none;
    max-height: 1px;
    min-height: 1px;
}

QFrame#verticalHairline {
    background: #E5DFD5;
    border: none;
    min-width: 1px;
    max-width: 1px;
}

/* -------------------------------------------------------------------------
   Buttons
   ------------------------------------------------------------------------- */

QPushButton#primaryButton {
    background-color: #2C2A26;
    color: #FCF8F0;
    border: 1px solid #2C2A26;
    border-radius: 12px;
    font-size: 13px;
    font-weight: 600;
    padding: 10px 20px;
}

QPushButton#primaryButton:hover {
    background-color: #3B3832;
    border-color: #3B3832;
}

QPushButton#primaryButton:pressed {
    background-color: #23211E;
    border-color: #23211E;
}

QPushButton#primaryButton:disabled {
    background-color: #D8D2C8;
    border-color: #D8D2C8;
    color: #9D978D;
}

QPushButton#secondaryButton {
    background-color: transparent;
    color: #4D4942;
    border: 1px solid #D7D0C5;
    border-radius: 12px;
    font-size: 13px;
    font-weight: 600;
    padding: 10px 18px;
}

QPushButton#secondaryButton:hover {
    background-color: #EEE9E0;
    border-color: #CDC5B9;
}

QPushButton#secondaryButton:pressed {
    background-color: #E6E0D5;
}

QPushButton#secondaryButton:disabled {
    color: #ADA79D;
    border-color: #E3DDD3;
}

QPushButton#dangerButton {
    background-color: #8E4F46;
    color: #FFF9F3;
    border: none;
    border-radius: 11px;
    font-size: 12px;
    font-weight: 700;
    padding: 9px 14px;
}
QPushButton#dangerButton:hover {
    background-color: #7C443C;
}
QPushButton#dangerButton:pressed {
    background-color: #6D3B34;
}
QPushButton#dangerButton:disabled {
    background-color: #E3D7D2;
    color: #A9948D;
}

QPushButton#quietButton {
    background-color: #EEE9E0;
    color: #4E4A43;
    border: none;
    border-radius: 11px;
    font-size: 12px;
    font-weight: 600;
    padding: 8px 14px;
}

QPushButton#quietButton:hover {
    background-color: #E6E0D5;
}

QPushButton#quietButton:pressed {
    background-color: #DDD6CA;
}

QPushButton#iconButton {
    background: transparent;
    border: none;
    border-radius: 9px;
    padding: 5px;
}

QPushButton#iconButton:hover {
    background: #EAE4DA;
}

QPushButton#iconButton:pressed {
    background: #E1DACE;
}

QPushButton#linkButton {
    background: transparent;
    border: none;
    color: #6F6A61;
    font-size: 12px;
    font-weight: 600;
    padding: 3px 1px;
    text-align: left;
}

QPushButton#linkButton:hover {
    color: #292723;
}

QFrame#stepper {
    background-color: #F8F6F1;
    border: 1px solid #DAD3C8;
    border-radius: 9px;
}

QPushButton#stepperButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    color: #5A554D;
    font-size: 15px;
    font-weight: 600;
    padding: 0px;
}

QPushButton#stepperButton:hover {
    background-color: #EAE4DA;
    color: #2C2A26;
}

QPushButton#stepperButton:pressed {
    background-color: #E0D9CE;
}

QPushButton#stepperButton:disabled {
    color: #C6C0B6;
}

QLabel#stepperValue {
    color: #3B3731;
    font-size: 11px;
    font-weight: 600;
}

/* -------------------------------------------------------------------------
   Analysis controls
   ------------------------------------------------------------------------- */

QLineEdit#pathField {
    background: #F1ECE3;
    border: 1px solid #E1DACE;
    border-radius: 9px;
    color: #4C4841;
    font-size: 11px;
    padding: 6px 10px;
    min-height: 17px;
}

QLineEdit#searchField {
    background: #FCFAF6;
    border: 1px solid #E1DACE;
    border-radius: 9px;
    color: #3B3731;
    font-size: 12px;
    padding: 6px 9px;
    min-height: 18px;
}

QLineEdit#searchField:focus,
QLineEdit#pathField:focus {
    border-color: #BFB7AA;
    background: #FFFDF9;
}

QLineEdit#searchField:disabled {
    color: #ACA69C;
    background: #F3EEE6;
}

QPushButton#filterChip {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: #7D776D;
    font-size: 11px;
    font-weight: 500;
    padding: 5px 6px;
    text-align: left;
}

QPushButton#filterChip:hover {
    background: #F1ECE3;
    color: #3C3832;
}

QPushButton#filterChip:checked {
    background: #E8E2D7;
    border-color: #DDD5C9;
    color: #2C2A26;
    font-weight: 600;
}

QPushButton#filterChip:disabled {
    color: #B4AEA4;
}

QTreeView#folderTree {
    background: transparent;
    border: none;
    color: #4B463F;
    font-size: 11px;
    show-decoration-selected: 1;
    selection-background-color: #E7E1D6;
    selection-color: #292723;
    outline: none;
}

QTreeView#folderTree::item {
    border-radius: 6px;
    padding: 3px 3px 3px 0px;
    min-height: 22px;
}

QTreeView#folderTree::item:hover {
    background: #F1ECE3;
}

QTreeView#folderTree::item:selected {
    background: #E7E1D6;
    color: #292723;
}

QTreeView#folderTree::branch {
    background: transparent;
}

QTableView#fileTable,
QTableWidget#fileTable {
    background: transparent;
    alternate-background-color: #F6F2EB;
    border: none;
    color: #403C36;
    font-size: 11px;
    gridline-color: transparent;
    selection-background-color: #E7E1D6;
    selection-color: #292723;
    outline: none;
}

QTableView#fileTable::item {
    padding: 5px 6px;
    border-bottom: 1px solid #EFEAE2;
}

QTableView#fileTable::item:selected {
    background: #E7E1D6;
    color: #292723;
}

QHeaderView::section {
    background: #F1ECE3;
    color: #8A847A;
    border: none;
    border-bottom: 1px solid #E4DDD2;
    padding: 7px 6px;
    font-size: 10px;
    font-weight: 600;
}

QTreeWidget#duplicateTree {
    background: transparent;
    alternate-background-color: #F6F2EB;
    border: none;
    color: #403C36;
    font-size: 11px;
    outline: none;
}

QTreeWidget#duplicateTree::item {
    padding: 5px 6px;
    border-bottom: 1px solid #EFEAE2;
}

QTreeWidget#duplicateTree::item:selected {
    background: #E7E1D6;
    color: #292723;
}

QProgressBar#scanProgress {
    background: #E9E3D8;
    border: none;
    border-radius: 3px;
}

QProgressBar#scanProgress::chunk {
    background: #4A463F;
    border-radius: 3px;
}

/* -------------------------------------------------------------------------
   Scroll areas
   ------------------------------------------------------------------------- */

QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 3px 0px;
}

QScrollBar::handle:vertical {
    background: #D4CDC2;
    min-height: 32px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #BEB6A9;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
    border: none;
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
}

QScrollBar::handle:horizontal {
    background: #D4CDC2;
    min-width: 32px;
    border-radius: 4px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
    border: none;
    width: 0px;
}

/* -------------------------------------------------------------------------
   Tooltips and dialogs
   ------------------------------------------------------------------------- */

QToolTip {
    background-color: #2E2B26;
    color: #F9F5EC;
    border: 1px solid #454139;
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 12px;
}

QDialog {
    background-color: #F3F0EA;
}

QMessageBox {
    background-color: #F3F0EA;
}

QMessageBox QLabel {
    color: #292723;
    font-size: 13px;
}

QMenu {
    background-color: #FCFAF6;
    color: #292723;
    border: 1px solid #DDD6CB;
    border-radius: 10px;
    padding: 6px;
}

QMenu::item {
    border-radius: 6px;
    padding: 7px 24px 7px 12px;
    font-size: 12px;
}

QMenu::item:selected {
    background-color: #EAE4DA;
}

/* -------------------------------------------------------------------------
   Empty states / stage scaffolding
   ------------------------------------------------------------------------- */

QFrame#emptyPanel {
    background: #F7F4EE;
    border: 1px dashed #D9D2C7;
    border-radius: 18px;
}

QFrame#cleanupCard {
    background: #F8F6F1;
    border: 1px solid #E5DFD5;
    border-radius: 15px;
}

QFrame#cleanupCard:hover {
    border-color: #D8D0C4;
}

QFrame#cleanupCard[selected="true"] {
    background: #FCFAF6;
    border-color: #CFC6B8;
}

QLabel#emptyTitle {
    color: #47433D;
    font-size: 17px;
    font-weight: 600;
}

QLabel#emptyBody {
    color: #8C867D;
    font-size: 12px;
}

/* -------------------------------------------------------------------------
   Progress
   ------------------------------------------------------------------------- */

QProgressBar#thinProgress {
    background-color: #E8E2D8;
    border: none;
    border-radius: 3px;
    max-height: 6px;
    min-height: 6px;
}

QProgressBar#thinProgress::chunk {
    background-color: #3A3731;
    border-radius: 3px;
}